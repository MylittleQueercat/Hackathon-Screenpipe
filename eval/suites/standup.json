{
 "description": "Daily standup notes posted to Slack and logged in Notion",
 "jobs": {
  "standup": {
   "expect": "published",
   "summary": "Write the daily standup in Slack and log it in Notion"
  },
  "vpn": {
   "expect": "unpublished",
   "summary": "One-off VPN client reinstall"
  }
 },
 "phases": {
  "1": [
   {
    "offset": -4,
    "runs": [
     {
      "job": "standup",
      "steps": [
       {
        "app": "Slack",
        "window": "#team-eng",
        "text": [
         "Channel",
         "Draft: yesterday I fixed the login bug",
         "Today: review PRs"
        ],
        "seconds": 40,
        "trigger": "key_press"
       },
       {
        "app": "Notion",
        "window": "Standup log",
        "text": [
         "Standup log",
         "Week entry 1",
         "Posted to team"
        ],
        "seconds": 35
       }
      ]
     }
    ]
   },
   {
